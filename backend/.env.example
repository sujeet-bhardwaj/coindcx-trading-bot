# Server Configuration
PORT=5000
NODE_ENV=development

# API Security & CORS (CRITICAL FOR PRODUCTION)
# Protects /api/bot/* endpoints and Socket.IO command events
API_SECRET_KEY=dev-secret-key
# Set to your frontend domain in production (e.g., https://your-app.vercel.app)
CORS_ORIGIN=*


# CoinDCX API Credentials (Keep secret! Never share or commit)
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Database
MONGODB_URI=mongodb://localhost:27017/coindcx_bot

# Trading Mode: Must be PAPER_TRADING by default. Changing to LIVE_TRADING requires explicit intent.
TRADING_MODE=PAPER_TRADING

# Unified Exit Engine Risk Management (TDS & Fee Aware)
DEFAULT_LEVERAGE=1
MAX_TRADE_AMOUNT=2500
MAX_DAILY_LOSS=250
MAX_LOSS_PERCENT=1.5
PROFIT_LOCK_LEVELS=3.5,5.5,8,12,15
PROFIT_LOCK_STEP_AFTER_LAST=1.5
LOCK_BUFFER_PERCENT=0.4
BREAKEVEN_TRIGGER_PERCENT=2.5
FEE_DEDUCTION_PERCENT=1.5
FEE_AWARE=true
COOLDOWN_SECONDS=60
LOSS_COOLDOWN_MINUTES=0
MAX_OPEN_POSITIONS=1
EVAL_INTERVAL_MS=10000

# Strategy Parameters (Institutional Trend Pullback Pro)
DEFAULT_STRATEGY=TREND_PULLBACK_PRO
DEFAULT_PAIR=BTCINR
FAST_EMA_PERIOD=20
SLOW_EMA_PERIOD=50
MACRO_EMA_PERIOD=200
ADX_PERIOD=14
MIN_ADX=18
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=35

# Paper Trading Settings
PAPER_INITIAL_BALANCE_USDT=10000
PAPER_INITIAL_BALANCE_INR=100000
PAPER_FEE_PERCENT=0.1

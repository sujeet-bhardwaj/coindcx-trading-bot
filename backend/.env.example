# Server Configuration
PORT=5000
NODE_ENV=development

# API Security & CORS (CRITICAL FOR PRODUCTION)
# Protects /api/bot/* endpoints and Socket.IO command events
API_SECRET_KEY=dev-secret-key
# Set to your frontend domain in production (e.g., https://your-app.vercel.app)
CORS_ORIGIN=*


# CoinDCX API Credentials (Keep secret! Never share or commit)
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Database
MONGODB_URI=mongodb://localhost:27017/coindcx_bot

# Trading Mode: Must be PAPER_TRADING by default. Changing to LIVE_TRADING requires explicit intent.
TRADING_MODE=PAPER_TRADING

# Unified Exit Engine Risk Management
DEFAULT_LEVERAGE=1
MAX_TRADE_AMOUNT=50
MAX_DAILY_LOSS=100
MAX_LOSS_PERCENT=0.75
PROFIT_LOCK_LEVELS=0.5,1,2,3,4,5
PROFIT_LOCK_STEP_AFTER_LAST=1
LOCK_BUFFER_PERCENT=0
BREAKEVEN_TRIGGER_PERCENT=0
COOLDOWN_SECONDS=60
MAX_OPEN_POSITIONS=1
EVAL_INTERVAL_MS=10000

# Strategy Parameters
DEFAULT_PAIR=BTCUSDT
FAST_EMA_PERIOD=20
SLOW_EMA_PERIOD=50
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# Paper Trading Settings
PAPER_INITIAL_BALANCE_USDT=10000
PAPER_INITIAL_BALANCE_INR=100000
PAPER_FEE_PERCENT=0.1

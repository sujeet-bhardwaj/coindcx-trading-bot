# Backend API and WebSocket URL for production
# Leave blank for local development (uses Vite proxy)
# In production (e.g. on Vercel), set to your live backend URL:
# VITE_BACKEND_URL=https://your-backend-app.onrender.com
VITE_BACKEND_URL=

# API Secret Key for securing bot control commands (matching backend API_SECRET_KEY)
VITE_API_SECRET_KEY=dev-secret-key

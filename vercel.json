{
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm --prefix frontend install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://coindcx-trading-bot-r377.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://coindcx-trading-bot-r377.onrender.com/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
